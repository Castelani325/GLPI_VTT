{% extends 'layout/page_login_split.html.twig' %}

{% block content_block %}
    <form action="{{ path('front/login.php') }}" method="post" autocomplete="off" data-submit-once>
        <input type="hidden" name="noAUTO" value="{{ noAuto }}"/>
        <input type="hidden" name="redirect" value="{{ redirect }}"/>
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"/>

        <h1 class="vtt-form-title">Bem-vindo</h1>
        <p class="vtt-form-sub">Faça login para acessar o portal de suporte</p>

        {% if text_login|length > 0 %}
            <div class="rich_text_container mb-4" style="font-size:13px;color:#5a6178;">
                {{ text_login|safe_html }}
            </div>
        {% endif %}

        <div class="mb-3">
            <label class="form-label" for="login_name">{{ __('Login') }}</label>
            <input type="text" class="form-control" id="login_name" name="login_name" placeholder="seu@email.com.br"/>
        </div>

        <div class="mb-4">
            <div class="vtt-label-row">
                <label class="form-label" for="login_password">{{ __('Password') }}</label>
                {% if show_lost_password and not config('display_login_source') %}
                    <a href="{{ path('front/lostpassword.php?lostpassword=1') }}" class="vtt-forgot">
                        {{ __('Forgotten password?') }}
                    </a>
                {% endif %}
            </div>
            <input type="password" class="form-control" id="login_password" name="login_password" placeholder="••••••••" autocomplete="off"/>
        </div>

        {% if config('display_login_source') %}
            <div class="mb-3">
                <label class="form-label" for="dropdown_auth{{ rand }}">{{ __('Login source') }}</label>
                {{ auth_dropdown_login|raw }}
            </div>
        {% endif %}

        {% if config('login_remember_time') %}
            <div class="mb-4">
                <label class="form-check" for="login_remember">
                    <input type="checkbox" class="form-check-input" id="login_remember" name="login_remember" {{ config('login_remember_default') ? 'checked' : '' }}/>
                    <span class="form-check-label">{{ __('Remember me') }}</span>
                </label>
            </div>
        {% endif %}

        <button type="submit" name="submit" class="vtt-submit">
            {{ __('Sign in') }}
        </button>

        {% if show_lost_password and config('display_login_source') %}
            <div class="text-center mt-3 forgot_password d-none">
                <a href="{{ path('front/lostpassword.php?lostpassword=1') }}" class="vtt-forgot">
                    {{ __('Forgotten password?') }}
                </a>
            </div>
            <script>
                $(() => {
                    if ($('select[name="auth"]').val() === 'local') {
                        $('.forgot_password').removeClass('d-none');
                    }
                    $('select[name="auth"]').on('change', function () {
                        if ($(this).val() === 'local') {
                            $('.forgot_password').removeClass('d-none');
                        } else {
                            $('.forgot_password').addClass('d-none');
                        }
                    });
                });
            </script>
        {% endif %}

        {% if config('use_public_faq') %}
            <div class="text-center mt-4">
                <a class="vtt-forgot" href="{{ path('front/helpdesk.faq.php') }}">
                    <i class="ti ti-help" style="vertical-align:middle;"></i> {{ __('FAQ') }}
                </a>
            </div>
        {% endif %}

        {% if right_panel %}
            {{ call_plugin_hook(constant('Glpi\\Plugin\\Hooks::DISPLAY_LOGIN')) }}
        {% endif %}
    </form>
{% endblock %}

{% block footer_block %}
    {{ copyright_message|raw }}
    {% if must_call_cron %}
        <div style="background-image: url('{{ path('/front/cron.php') }}');"></div>
    {% endif %}
{% endblock %}

{% block javascript_block %}
    <script type="text/javascript">
        $(function () {
            $('#login_name').focus();
        });
    </script>
{% endblock %}
